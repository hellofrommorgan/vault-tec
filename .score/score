#!/usr/bin/env bash
# Score — dispatch to subcommands
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

case "${1:-}" in
  -h|--help|"")
    echo "Usage: score {init|verify|status|audit|run|plan|add}"
    echo ""
    echo "Score is an OS for agentic CLIs. The agent becomes Score"
    echo "by reading the SOP and following the protocol."
    echo ""
    echo "Commands:"
    echo "  init              Install Score OS into a new repo"
    echo "  verify <id>       Run tests and update pass/fail for a feature"
    echo "  status            Show vision, progress, knowledge, and next work item"
    echo "  audit             Re-verify all passed features match reality"
    echo "  run [max]         Autonomous iteration loop (default: 10 max iterations)"
    echo "  plan              Read vision, show state, prompt for intent decomposition"
    echo "  add <name> [...]  Add a feature with optional verification criteria"
    exit 0
    ;;
  init)    shift; exec "$SCRIPT_DIR/init.sh" "$@" ;;
  verify)  shift; exec "$SCRIPT_DIR/verify.sh" "$@" ;;
  status)  shift; exec "$SCRIPT_DIR/status.sh" "$@" ;;
  audit)   shift; exec "$SCRIPT_DIR/audit.sh" "$@" ;;
  run)     shift; exec "$SCRIPT_DIR/run.sh" "$@" ;;
  plan)    shift; exec "$SCRIPT_DIR/plan.sh" "$@" ;;
  add)     shift; exec "$SCRIPT_DIR/add.sh" "$@" ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Run 'score --help' for usage." >&2
    exit 1
    ;;
esac
