#!/usr/bin/env bash
# bin/vault-refile-append <source-md> <vault-root>
#
# Closes the North Star "refiled" edge. Takes an external markdown file
# produced OUTSIDE the vault (e.g., a meeting note, chat excerpt, copilot
# insight) and deposits it into $VAULT/ops/raw/ with provenance
# frontmatter, so the next /compile run ingests it naturally.
#
# Contract (see tests/test_refile_slice.sh):
#   - single source, single landing.
#   - SHA idempotence: if original_sha256 already present in any
#     ops/raw/*.md frontmatter, exit 0 and create nothing new.
#   - hard refuse sources whose realpath is under $VAULT/ops/out/
#     (prevents self-fueling render → raw loops).
#   - atomic write (tmpfile + mv).
#   - appends a line to ops/reports/refile-report.md.
#   - NEVER writes to notes/. Compile is bin/vault-compile-replay's job.
#
# Provenance frontmatter keys:
#   source, refiled_at, refiled_by, original_sha256
#
# Exit codes:
#   0  landed (or duplicate, no-op)
#   1  source missing / unreadable / under ops/out/ / other fail-loud
#   2  misuse (bad argc, bad vault root)

set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: $0 <source-md> <vault-root>" >&2
  exit 2
fi

SRC="$1"
VAULT="$2"

if [ ! -d "$VAULT" ]; then
  echo "vault-refile-append: vault root $VAULT not a directory" >&2
  exit 2
fi

RAW="$VAULT/ops/raw"
REPORTS="$VAULT/ops/reports"

if [ ! -d "$RAW" ]; then
  echo "vault-refile-append: no $RAW ingress dir (create it first)" >&2
  exit 2
fi

if [ ! -f "$SRC" ]; then
  echo "vault-refile-append: source $SRC not found or not a file" >&2
  exit 1
fi

# realpath both source and ops/out/ to refuse self-fueling loop
# (portable realpath via python3)
ABS_SRC="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$SRC")"
ABS_OUT="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$VAULT/ops/out")"
case "$ABS_SRC" in
  "$ABS_OUT"/*|"$ABS_OUT")
    echo "vault-refile-append: refusing ops/out/ source (derived-only; would create self-fueling loop): $ABS_SRC" >&2
    exit 1
    ;;
esac

# compute SHA. By default = SHA of the source file bytes. If a wrapper
# (e.g. bin/vault-ingest-pdf converting a PDF to markdown on a tmp path)
# attests to the ORIGINAL non-markdown artifact, it can override via env:
#
#   REFILED_ORIGINAL_PATH     — replaces the "source:" fm value (must be
#                               absolute, must exist, and must NOT live
#                               under $VAULT/ops/out/)
#   REFILED_ORIGINAL_SHA256   — replaces the original_sha256 fm value and
#                               is the idempotence key. Honest contract:
#                               this MUST match shasum of the file at
#                               REFILED_ORIGINAL_PATH — we verify.
#   REFILED_ORIGINAL_FORMAT   — optional free-form tag emitted as
#                               "original_format:" (e.g. "pdf", "docx").
#
# This keeps vault-refile-append as the single landing primitive while
# letting format-specific ingesters attest to the real external artifact.

if [ -n "${REFILED_ORIGINAL_PATH:-}" ]; then
  OPATH="$REFILED_ORIGINAL_PATH"
  if [ ! -f "$OPATH" ]; then
    echo "vault-refile-append: REFILED_ORIGINAL_PATH $OPATH not found" >&2
    exit 1
  fi
  ABS_OPATH="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$OPATH")"
  case "$ABS_OPATH" in
    "$ABS_OUT"/*|"$ABS_OUT")
      echo "vault-refile-append: refusing ops/out/ original path: $ABS_OPATH" >&2
      exit 1
      ;;
  esac
  REAL_SHA="$(shasum -a 256 "$OPATH" | awk '{print $1}')"
  if [ -n "${REFILED_ORIGINAL_SHA256:-}" ]; then
    if [ "$REFILED_ORIGINAL_SHA256" != "$REAL_SHA" ]; then
      echo "vault-refile-append: REFILED_ORIGINAL_SHA256 mismatch for $OPATH" >&2
      echo "  declared: $REFILED_ORIGINAL_SHA256" >&2
      echo "  actual:   $REAL_SHA" >&2
      exit 1
    fi
  fi
  SHA="$REAL_SHA"
  PROV_SOURCE="$OPATH"
else
  SHA="$(shasum -a 256 "$SRC" | awk '{print $1}')"
  PROV_SOURCE="$SRC"
fi

# idempotence check: scan existing ops/raw/*.md frontmatter for this SHA
EXISTING=""
for f in "$RAW"/*.md; do
  [ -f "$f" ] || continue
  if grep -q "^original_sha256: $SHA$" "$f" 2>/dev/null; then
    EXISTING="$f"
    break
  fi
done

if [ -n "$EXISTING" ]; then
  echo "vault-refile-append: duplicate sha256 — already landed at $EXISTING (no-op)"
  exit 0
fi

# pick landing filename: basename of source, disambiguate if collision
BASE="$(basename "$SRC")"
case "$BASE" in
  *.md) STEM="${BASE%.md}" ;;
  *)    STEM="$BASE" ;;
esac

LANDED="$RAW/${STEM}.md"
N=1
while [ -e "$LANDED" ]; do
  LANDED="$RAW/${STEM}-${N}.md"
  N=$((N + 1))
done

NOW="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
BY="${REFILED_BY:-unknown}"

TMP_OUT="$(mktemp "$RAW/.refile.XXXXXX")"
# cleanup on failure
trap '[ -f "$TMP_OUT" ] && rm -f "$TMP_OUT"' EXIT

# If source has its own YAML frontmatter, merge a small allowlist of producer-
# declared keys into the landed frontmatter. Provenance keys (source,
# refiled_*, original_*) are owned by the refile primitive and always win.
# Allowlisted producer keys: compile, title, topic
PRODUCER_FM="$(python3 - "$SRC" <<'PY'
import sys, re, json
allow = {"compile", "title", "topic"}
with open(sys.argv[1], "r", encoding="utf-8", errors="replace") as fh:
    text = fh.read()
out = {"_body_offset": 0}
m = re.match(r"^---\s*\n(.*?\n)---\s*\n", text, re.DOTALL)
if m:
    body_offset = m.end()
    for line in m.group(1).splitlines():
        line = line.rstrip()
        if not line or line.startswith("#"):
            continue
        kv = re.match(r"^([A-Za-z0-9_]+)\s*:\s*(.*)$", line)
        if not kv:
            continue
        k, v = kv.group(1), kv.group(2).strip()
        if k in allow:
            out[k] = v
    out["_body_offset"] = body_offset
print(json.dumps(out))
PY
)"

PRODUCER_COMPILE="$(printf '%s' "$PRODUCER_FM" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("compile",""))')"
BODY_OFFSET="$(printf '%s' "$PRODUCER_FM" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("_body_offset",0))')"

# Validate compile value if present
case "${PRODUCER_COMPILE}" in
  ""|whole|sections|skip) : ;;
  *)
    echo "vault-refile-append: invalid compile mode in source frontmatter: $PRODUCER_COMPILE" >&2
    exit 1
    ;;
esac

{
  printf -- '---\n'
  printf 'source: %s\n'           "$PROV_SOURCE"
  printf 'refiled_at: %s\n'       "$NOW"
  printf 'refiled_by: %s\n'       "$BY"
  printf 'original_sha256: %s\n'  "$SHA"
  if [ -n "${REFILED_ORIGINAL_FORMAT:-}" ]; then
    printf 'original_format: %s\n' "$REFILED_ORIGINAL_FORMAT"
  fi
  if [ -n "$PRODUCER_COMPILE" ]; then
    printf 'compile: %s\n' "$PRODUCER_COMPILE"
  fi
  printf -- '---\n\n'
  if [ "$BODY_OFFSET" -gt 0 ]; then
    # strip producer frontmatter, write only body
    python3 -c 'import sys; o=int(sys.argv[1]); sys.stdout.write(open(sys.argv[2],"r",encoding="utf-8",errors="replace").read()[o:])' "$BODY_OFFSET" "$SRC"
  else
    cat "$SRC"
  fi
} > "$TMP_OUT"

# atomic landing
mv "$TMP_OUT" "$LANDED"
trap - EXIT

# append to refile-report
mkdir -p "$REPORTS"
REPORT="$REPORTS/refile-report.md"
if [ ! -f "$REPORT" ]; then
  {
    printf '# refile-report\n\n'
    printf 'Log of external artifacts deposited via bin/vault-refile-append.\n\n'
    printf '| refiled_at | source | original_sha256 | landed |\n'
    printf '|---|---|---|---|\n'
  } > "$REPORT"
fi

REL_LANDED="ops/raw/$(basename "$LANDED")"
printf '| %s | %s | %s | %s |\n' "$NOW" "$PROV_SOURCE" "$SHA" "$REL_LANDED" >> "$REPORT"

echo "Refiled $PROV_SOURCE -> $REL_LANDED (sha256=$SHA)"
